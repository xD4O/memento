# Memento — shared config template. Copy to .env and fill in.
# Real values live ONLY in .env (gitignored). Generate secrets with:
#   openssl rand -hex 32

DATABASE_URL=postgres://memento:CHANGE_ME@localhost:5433/memento

S3_ENDPOINT_HOST=localhost
S3_ENDPOINT_PORT=9400
S3_ACCESS_KEY=memento
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=memento-media

# Single-user phase: fixed operator id (multi-tenant-shaped, plan R-03)
MEMENTO_USER_ID=00000000-0000-0000-0000-000000000001

# Transcription
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE=int8

# Web
PORT=8742

# Entry metadata + reflection (local Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Vision enrichment (local VLM)
VISION_MODEL=qwen2.5vl:7b

# Morning briefing / evening nudge push (self-hosted ntfy)
NTFY_URL=http://localhost:8744
NTFY_TOPIC=memento-briefing-CHANGE_ME

# Live agent (server-side only; can also be set per-user in Settings UI)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin

# Auth: AUTH_SECRET signs session cookies; AUTH_HASH is a legacy scrypt
# passphrase fallback (normally lives in users.settings via /register)
AUTH_SECRET=CHANGE_ME_openssl_rand_hex_32
AUTH_HASH=

# Backups: AES key for offsite bundles + optional sync hook (rclone/rsync)
BACKUP_KEY=CHANGE_ME_openssl_rand_hex_32
OFFSITE_CMD=

# Docker service credentials + ntfy tailnet bind (compose reads this file)
POSTGRES_PASSWORD=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
NTFY_BIND_IP=127.0.0.1

# Dev-server allowed origins (next dev only), comma-separated
DEV_ORIGINS=
